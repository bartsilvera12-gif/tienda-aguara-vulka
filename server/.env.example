# Aguara + Vulka Payments API — plantilla de variables.
# Copiar a `server/.env` en la VPS y completar. NUNCA commitear el .env con claves.

PORT=8788

# ── PagoPar ────────────────────────────────────────────────────────────────
# Credenciales del comercio (panel PagoPar). Las de DESARROLLO se usan con
# PAGOPAR_ENV=staging; al pasar a produccion se reemplazan por las reales
# (pestana PRODUCCION del panel) y se cambia PAGOPAR_ENV=production.
PAGOPAR_PUBLIC_KEY=
PAGOPAR_PRIVATE_KEY=

# Ambiente:
#   staging     — pruebas. Con PAGOPAR_STAGING_USE_OFFICIAL_HOSTS=1 usa las
#                 credenciales de prueba contra api.pagopar.com (caso estandar).
#   production  — hosts oficiales (api.pagopar.com / www.pagopar.com), claves reales.
PAGOPAR_ENV=staging
PAGOPAR_STAGING_USE_OFFICIAL_HOSTS=1

# URLs de callback. `${hash}` en RETURN_URL es un placeholder que reemplaza
# PagoPar con el hash del pedido antes de redirigir al comprador. En WEBHOOK
# no hay placeholders: PagoPar hace POST con hash_pedido y token en el body.
# El return apunta al SITIO (Hostinger); el webhook al SERVER (VPS, bajo /pagopar).
PAGOPAR_RETURN_URL=https://aguarafitwear.com.py/gracias-por-su-compra/?hash=${hash}
PAGOPAR_WEBHOOK_URL=https://api.neura.com.py/pagopar/webhook

# forma_pago:
#   9  — todos los medios (default)
#   1  — solo tarjeta
PAGOPAR_FORMA_PAGO=9

# Item de catalogo (categoria + ciudad + producto_id de PagoPar). Placeholders
# validos que dejan pasar la transaccion; ajustar si tu panel lo requiere.
PAGOPAR_ITEM_CATEGORIA=909
PAGOPAR_ITEM_CIUDAD=1
PAGOPAR_ITEM_PRODUCTO_ID=895
PAGOPAR_ITEM_IMAGEN_URL=https://www.pagopar.com/static/img/logo.png

# El wrapper "orderPagopar" era una variante historica. Dejar en 0.
PAGOPAR_ORDER_WRAPPER=0

# ── Supabase (persistencia OPCIONAL del pedido) ─────────────────────────────
# Si se configura, al crear el pago se guarda el pedido en
# `aguaravulka.web_pedidos` (estado pendiente) y el webhook lo marca pagado.
# Es best-effort: si faltan estas variables, el cobro sigue funcionando pero el
# pedido NO se registra. Correr antes supabase/11-pedidos-web.sql.
#   SUPABASE_URL:               https://api.neura.com.py
#   SUPABASE_SERVICE_ROLE_KEY:  clave service_role (SECRETA, nunca commitear)
#   SUPABASE_SCHEMA:            aguaravulka
SUPABASE_URL=https://api.neura.com.py
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SCHEMA=aguaravulka

# ── CORS ───────────────────────────────────────────────────────────────────
# Dominios del frontend que pueden llamar a este server. Coma-separado.
ALLOWED_ORIGINS=https://aguarafitwear.com.py,https://www.aguarafitwear.com.py
