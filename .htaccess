# ===== MODO MANTENIMIENTO =====
# Mientras este bloque exista, toda la tienda (incluido admin.html) responde 503
# con mantenimiento.html. PARA REABRIR LA TIENDA: borrar este archivo (o este bloque),
# commit + push a main.
ErrorDocument 503 /mantenimiento.html
RewriteEngine On
RewriteCond %{REQUEST_URI} !^/mantenimiento\.html$
RewriteCond %{REQUEST_URI} !^/uploads/opt/aguara-word-white\.png$
RewriteCond %{REQUEST_URI} !^/favicon\.(png|ico)$
RewriteRule ^ - [R=503,L]
<IfModule mod_headers.c>
  Header always set Retry-After "86400"
  Header always set Cache-Control "no-store"
</IfModule>
